# Copy to backend/.env and fill in. The backend container picks these
# up via docker-compose's env_file convention (the root .env at the
# repo level is also read when running via the root orchestrator).

# Postgres connection. Same password the postgres service uses.
POSTGRES_PASSWORD=replace-me-with-a-strong-password

# Redis AUTH. Same password the redis service uses.
REDIS_PASSWORD=replace-me-with-a-strong-password

# JWT signing key (HS256). MUST be >= 32 bytes after base64-decode.
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32

# AES-256-GCM master key for the envelope encryption used by
# TimeFlow.Vault. Same key the legacy stack used — preserved so any
# existing encrypted blobs in Postgres (OpenProject PATs, AI provider
# keys, 2FA secrets) round-trip. 32 bytes base64.
VAULT_KEY=replace-with-openssl-rand-base64-32
