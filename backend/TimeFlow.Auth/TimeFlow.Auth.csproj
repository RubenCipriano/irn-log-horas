<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TimeFlow.Cache\TimeFlow.Cache.csproj" />
    <ProjectReference Include="..\TimeFlow.Data\TimeFlow.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.0" />
    <!--
      Konscious.Security.Cryptography.Argon2 — managed Argon2id. Used over
      ASP.NET Identity's PasswordHasher (which is PBKDF2) because Argon2id
      is the OWASP-recommended algorithm for new systems.
    -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!--
      Otp.NET — RFC 6238 TOTP. Tiny pure-managed implementation; no
      external dependencies. Used for the 2FA enrol + verify flow.
    -->
    <PackageReference Include="Otp.NET" Version="1.4.0" />
  </ItemGroup>

  <!--
    Pulls in Microsoft.AspNetCore.* without bloating the output — the
    framework reference uses the runtime's shared ASP.NET assemblies.
    Required because JwtCookieAuthHandler extends AuthenticationHandler<T>.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
